[Unit]
Description=ShapeBit OS first-boot initialization
ConditionPathExists=!/var/lib/shapebit-os/firstboot-complete
After=local-fs.target
Before=getty.target

[Service]
Type=oneshot
ExecStart=/usr/bin/mkdir -p /var/lib/shapebit-os
ExecStart=/usr/bin/touch /var/lib/shapebit-os/firstboot-complete
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
